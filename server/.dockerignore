*
# Default-deny the build context. Keep local dumps, credentials, diagnostics,
# native binaries, private services, and developer tools out of BuildKit.
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!LICENSE
!dotnet-tools.json

!docker/
docker/*
!docker/server.Dockerfile
!docker/postgres.Dockerfile

!app/
app/*
!app/src/
!app/src/**
!app/public/
!app/public/**
!app/schema.sql

!shared/
!shared/**

!scripts/
scripts/*
!scripts/portable-sources.ts

!worker/
!worker/**
worker/**/bin/
worker/**/bin/**
worker/**/obj/
worker/**/obj/**
worker/**/TestResults/
worker/**/TestResults/**

!upstream/
upstream/*
!upstream/LibProsperoPKG-drakmor/
upstream/LibProsperoPKG-drakmor/*
!upstream/LibProsperoPKG-drakmor/LICENSE
!upstream/LibProsperoPKG-drakmor/NOTICE
!upstream/LibProsperoPKG-drakmor/README.md
!upstream/LibProsperoPKG-drakmor/src/
upstream/LibProsperoPKG-drakmor/src/*
!upstream/LibProsperoPKG-drakmor/src/LibProsperoPkg/
!upstream/LibProsperoPKG-drakmor/src/LibProsperoPkg/**
!upstream/UFS2Tool/
upstream/UFS2Tool/*
!upstream/UFS2Tool/*.cs
!upstream/UFS2Tool/*.csproj
!upstream/UFS2Tool/LICENSE
!upstream/UFS2Tool/app.manifest

# A broad source include must never pull local build products, credentials,
# diagnostics, database files, packages, or downloaded archives into BuildKit.
**/bin/
**/bin/**
**/obj/
**/obj/**
**/build/
**/build/**
**/dist/
**/dist/**
**/TestResults/
**/TestResults/**
**/.env
**/.env.*
**/.tmp-*
**/tmp-*
**/*.log
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.elf
**/*.pkg
**/*.ffpkg
**/*.ffpfs
**/*.ffpfsc
**/*.exfat
**/*.pup
**/*.exe
**/*.dll
**/*.pdb
**/*.so
**/*.dylib
**/*.pem
**/*.dmp
**/*.core
**/*.zip
**/*.7z
**/*.tar
**/*.tar.*
**/*.rar

# Deterministic, synthetic multipart fixtures exercised by the Linux worker
# build. Their README records their generated, non-commercial contents.
!worker/Tests/Fixtures/homebrew.part1.rar
!worker/Tests/Fixtures/homebrew.part2.rar
!worker/Tests/Fixtures/homebrew.part3.rar
!worker/Tests/Fixtures/homebrew.part4.rar
