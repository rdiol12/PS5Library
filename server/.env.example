HOST=127.0.0.1
PORT=3150
TZ=UTC
PUBLIC_URL=http://127.0.0.1:3150
SERVER_BIND=127.0.0.1
# Linux bind-mount ownership. Use `id -u` and `id -g` when these differ.
PUID=1000
PGID=1000
# Required only by the prebuilt runtime Compose overlay.
PS5LIBRARY_SERVER_IMAGE=
# Optional public HTTPS front door. Add the `https` Compose profile only after
# this exact hostname points to the server and router ports 80/443 are forwarded.
PS5LIBRARY_HTTPS_HOST=
# COMPOSE_PROFILES=https
# Additional browser addresses, comma-separated exact origins (no paths/wildcards).
# Example when PUBLIC_URL is the LAN address: http://127.0.0.1:3150,http://localhost:3150
BROWSER_ORIGINS=
# Number of trusted reverse-proxy hops in front of the API. Keep zero unless
# direct access to the API port is blocked and Caddy is the only ingress.
TRUST_PROXY_HOPS=0
POSTGRES_PASSWORD=GENERATE_WITH_NPM_RUN_SETUP
DATABASE_URL=postgresql://ps5library:GENERATE_WITH_NPM_RUN_SETUP@127.0.0.1:54329/ps5library
REDIS_URL=redis://127.0.0.1:63799
BOOTSTRAP_TOKEN=GENERATE_WITH_NPM_RUN_SETUP
# Optional controller. Set both values to enable admin service restarts.
# COMPOSE_PROFILES=operator
# OPERATOR_URL=http://operator:3160
# The controller has no published port and accepts only health/status and
# fixed service restart operations.
OPERATOR_TOKEN=GENERATE_WITH_NPM_RUN_SETUP
# Persistent server output: packages, native updates, artwork, jobs and logs.
DATA_DIR=./data
SOURCE_ROOT=./data/sources
# Folder watched for newly added authorized dumps. Empty uses DATA_DIR/dumps.
DUMP_ROOT=
DUMP_AUTO_PREPARE=FPKG
# Backport copies live under DATA_DIR/backports. Builds preserve source dumps;
# an explicit verified administrator retirement may remove one afterward.
TRAILER_WORKER_IMAGE=ps5library-build:0.43
# Host development uses a one-shot Docker transcoder. Compose uses its networkless
# worker container over a private Unix socket.
TRAILER_WORKER_MODE=DOCKER
# Optional Windows acceleration for large packages. The host worker binds only
# to loopback and requires this random token; leave both blank for Docker-only.
PACKAGE_WORKER_URL=
PACKAGE_WORKER_TOKEN=
# npm run docker:configure adds DOCKER_DATABASE_URL, DOCKER_DATA_DIR,
# DOCKER_SOURCE_ROOT and DOCKER_DUMP_ROOT from the values above.
# Optional logical storage cap. Use 0 to rely on real free-space checks only.
QUOTA_BYTES=0
DISK_MARGIN_BYTES=1073741824
# Explicitly allow individual private repository origins; never a wildcard.
PRIVATE_HTTP_ORIGINS=
# Optional PS5Library Community Master. Must be one exact HTTPS origin.
COMMUNITY_MASTER_URL=
# Startup feature controls. Values must be exactly true or false. Restart the
# server after editing them; active jobs are allowed to finish.
ENABLE_COMPANION_APP=true
ENABLE_PS5_CONNECTIONS=true
ALLOW_ACCOUNT_REGISTRATION=true
ENABLE_COMMUNITY_FEATURES=true
ENABLE_NEW_DOWNLOADS=true
# Experimental: route Home update checks through the paired console agent so
# native download cards can use the registered title and icon.
ENABLE_HOME_UPDATE_BRIDGE=false
# Optional single-console bridge address. Keep this local; never commit a real console IP.
HOME_UPDATE_AGENT_URL=
# Reference repositories may use a bearer token from a named environment variable.
# REPOSITORY_TOKEN_MY_REPO=
