{
  "name": "ps5library",
  "version": "0.2.91",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23 || >=24.18.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write \"app/src/**/*.ts\" \"app/tests/**/*.{ts,mjs}\" \"app/public/*.{js,css,html}\" \"scripts/**/*.{ts,mjs}\" \"shared/**/*.ts\"",
    "format:check": "prettier --check \"app/src/**/*.ts\" \"app/tests/**/*.{ts,mjs}\" \"app/public/*.{js,css,html}\" \"scripts/**/*.{ts,mjs}\" \"shared/**/*.ts\"",
    "format:native": "node scripts/format-native.mjs",
    "format:native:check": "node scripts/format-native.mjs --check",
    "format:worker": "dotnet tool run csharpier format worker",
    "format:worker:check": "dotnet tool run csharpier check worker",
    "start": "node --env-file=.env dist/app/src/main.js",
    "dev": "node --env-file=.env --import tsx app/src/main.ts",
    "migrate": "node --env-file=.env --import tsx app/src/migrate.ts",
    "test": "node --import tsx --test app/tests/*.test.ts",
    "test:integration": "node --env-file=.env --import ./app/tests/integration/setup.mjs --import tsx --test --test-concurrency=1 app/tests/integration/*.test.ts",
    "build:worker": "dotnet build worker/PS5Library.Worker.csproj -c Release",
    "test:worker": "dotnet run --project worker/Tests/PS5Library.Worker.Checks.csproj -c Release",
    "setup": "node scripts/setup.mjs",
    "docker:configure": "node --env-file=.env scripts/docker-configure.mjs",
    "docker:up": "npm run docker:configure && docker compose --env-file .env -f docker/compose.yml up -d --build --wait",
    "docker:restart": "docker compose --env-file .env -f docker/compose.yml restart server",
    "docker:logs": "docker compose --env-file .env -f docker/compose.yml logs -f --tail=200 server worker redis",
    "test:container": "node --env-file=.env scripts/check-container.mjs",
    "test:native": "node --env-file=.env --import tsx --test --test-concurrency=1 app/tests/native/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/websocket": "11.3.0",
    "bullmq": "5.81.5",
    "fastify": "5.12.5",
    "ipaddr.js": "2.5.0",
    "pg": "8.23.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "@wasm-fmt/clang-format": "23.1.1",
    "prettier": "3.6.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
