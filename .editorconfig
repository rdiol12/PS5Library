root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{js,json,mjs,ts,yaml,yml}]
indent_style = space
indent_size = 2

[*.{c,cc,cpp,h,hpp}]
indent_style = space
indent_size = 2

[*.{cs,swift}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
